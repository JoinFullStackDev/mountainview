# Supabase Configuration
# Copy this file to .env.local and fill in your values

# Canonical site URL (no trailing slash). Drives sitemap.xml,
# robots.txt, the OG `metadataBase` in src/app/layout.tsx, and the
# redirect URL used by admin invitation / password-reset emails sent
# through Supabase. Optional in local dev (we fall back to the request
# origin), but you SHOULD set it on each deployed environment so the
# email links land on the right host:
#   local      -> http://localhost:3000   (optional)
#   staging    -> https://staging.mtviewpharmacy.com
#   production -> https://mtviewpharmacy.com
#
# Whichever URL you use here must also be listed under
# Authentication -> URL Configuration -> Redirect URLs in the Supabase
# dashboard, otherwise Supabase will silently fall back to its
# project-level "Site URL" setting (likely http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://mtviewpharmacy.com

# Public - safe to expose in browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Private - server only (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile (Bot Protection)
# Get keys from: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Resend (Transactional Email)
# Get an API key from: https://resend.com/api-keys
# RESEND_FROM_EMAIL must use a domain you've verified in Resend.
# PHARMACY_CONTACT_EMAIL is where contact / transfer / medical-kit
# form submissions are delivered.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Mountain View Pharmacy <noreply@mtviewpharmacy.com>
PHARMACY_CONTACT_EMAIL=info@mtviewpharmacy.com
